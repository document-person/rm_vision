<launch>
    <!--开启模拟时间-->
    <param name="/use_sim_time" value="true" />

    <rosparam file="$(find rm_vision)/config/params.yaml" command="load" ns="image_sub" />
    
    <node name="image_sub" pkg="rm_vision" type="image_sub" output="screen" />

        <!--一键启动 RViz 并加载配置-->
    <node pkg="rviz" type="rviz" name="rviz" 
          args="-d $(find rm_vision)/config/armor_config.rviz" />

</launch>